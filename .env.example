# Secret token for WordPress revalidation webhook
# Set this in Vercel environment variables and in WordPress plugin/function
REVALIDATE_SECRET=your-secret-token-here

# Vercel Postgres (Disco events + promo popup). Auto-injected by the Vercel
# Postgres / Neon integration. POSTGRES_PRISMA_URL is the pooled URL used by the
# app; POSTGRES_URL_NON_POOLING is the direct URL used for Prisma migrations.
POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/db?schema=public
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/db?schema=public

# Shared password for the /admin area.
ADMIN_PASSWORD=change-me
