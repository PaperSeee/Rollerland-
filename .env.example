# Secret token for WordPress revalidation webhook
# Set this in Vercel environment variables and in WordPress plugin/function
REVALIDATE_SECRET=your-secret-token-here

# Postgres (Disco events + promo popup). Auto-injected by the Neon integration
# on Vercel: DATABASE_URL is the pooled URL used by the app; DATABASE_URL_UNPOOLED
# is the direct URL used for Prisma migrations.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# Shared password for the /admin area.
ADMIN_PASSWORD=change-me
