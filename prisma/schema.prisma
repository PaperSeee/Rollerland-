// Prisma schema for Rollerland Brussels.
// Datasource uses Vercel Postgres env vars (pooled URL for the app, a direct
// non-pooled URL for migrations). Locally both point at the same database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon's Vercel integration injects DATABASE_URL (pooled) and
  // DATABASE_URL_UNPOOLED (direct, used for migrations).
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Disco Roller events, managed from /admin and rendered on /disco-roller.
// Shape mirrors the previous hardcoded FALLBACK_EVENTS so the UI is unchanged.
model DiscoEvent {
  id          String   @id @default(cuid())
  date        DateTime @db.Date // sortable; rendered via the page's formatDate()
  day         String // "Vendredi" / "Samedi"
  theme       String
  description String
  dj          String?
  time          String // free-text horaire, e.g. "17h00 – 00h00"
  special       Boolean  @default(false)
  image         String?
  imagePosition String?  @default("center") // CSS object-position (simple crop)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
}

// Singleton (always id = 1) holding the promotional popup configuration edited
// from /admin/popup and rendered once-per-visitor across the site.
model PopupSettings {
  id            Int      @id @default(1)
  enabled       Boolean  @default(false)
  title         String   @default("")
  body          String   @default("")
  imageUrl      String?
  imagePosition String?  @default("center") // CSS object-position (simple crop)
  ctaLabel      String?
  ctaUrl        String?
  updatedAt     DateTime @updatedAt
}

// Singleton (id = 1) holding ALL editable site content as a JSON blob. Same
// keys as the WPAcf shape (home_*, formules[], partners[], rules[], …). Edited
// from /admin/content/*, read by getRollerland(). Replaces WordPress as the
// content source.
model SiteContent {
  id        Int      @id @default(1)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// Cache of machine translations (English source → FR/NL via DeepL). Keyed by a
// hash of the source text + target locale so identical strings are translated
// once. Lets the site auto-translate WordPress/admin content without re-calling
// DeepL on every render.
model Translation {
  id        String   @id @default(cuid())
  hash      String   @unique // sha256(targetLocale + "::" + source)
  locale    String // "fr" | "nl"
  source    String   @db.Text
  result    String   @db.Text
  createdAt DateTime @default(now())

  @@index([locale])
}
